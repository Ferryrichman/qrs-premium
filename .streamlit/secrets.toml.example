# ─────────────────────────────────────────────────────────
# Local development secrets template
# ─────────────────────────────────────────────────────────
# 1. Copy this file to: .streamlit/secrets.toml  (no .example)
# 2. Set your actual password below
# 3. NEVER commit secrets.toml to git (already in .gitignore)
#
# For Streamlit Cloud deployment:
#   - DO NOT upload secrets.toml
#   - Set the secret via Streamlit Cloud UI:
#     App settings → Secrets → paste the line below

access_password = "CHANGE_ME_TO_YOUR_REAL_PASSWORD"
