# ─────────────────────────────────────────────────────────
# FRM ETF Premium — Streamlit secrets template
# ─────────────────────────────────────────────────────────
# 1. Copy this file to: .streamlit/secrets.toml  (no .example)
# 2. Set FRM_SUB_SECRET to the SAME value as POPI backend's
#    FRM_SUB_SECRET env var. Generate once with:
#       python -c "import secrets; print(secrets.token_hex(32))"
#    All FerryRichMan services share this key — that's how Token
#    issued by POPI's /api/subscription/redeem can be verified
#    locally here without any cross-service API call.
# 3. NEVER commit secrets.toml to git (already in .gitignore)
#
# For Streamlit Cloud deployment:
#   - DO NOT upload secrets.toml
#   - Set the secret via Streamlit Cloud UI:
#     App settings → Secrets → paste the line below

FRM_SUB_SECRET = "PASTE_SAME_HEX_AS_POPI_BACKEND_FRM_SUB_SECRET_ENV_VAR"
